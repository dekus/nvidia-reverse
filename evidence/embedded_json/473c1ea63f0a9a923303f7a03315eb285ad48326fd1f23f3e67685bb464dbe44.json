          ]
        },
        "UserConsent": {
          "type": "object",
          "description": "Starfleet id information",
          "properties": {
            "consentExpiry": {
              "type": "string"
            },
            "hasFunctionalConsent": {
              "type": "boolean"
            },
            "hasTechnicalConsent": {
              "type": "boolean"
            },
            "hasBehavioralConsent": {
              "type": "boolean"
            }
          },
          "required": [
            "consentExpiry",
            "hasFunctionalConsent",
            "hasTechnicalConsent",
            "hasBehavioralConsent"
          ]
        }
      },
      "properties": {
        "tokens": {
          "description": "Tokens information URLEncoded and Base64 encoded",
          "type": "string"
        },
        "userId": {
          "$ref": "#/definitions/UserId"
        },
        "preferredUsername": {
          "type": "string"
        },

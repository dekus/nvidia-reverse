        "PostProcessingAction": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "name of the action"
            },
            "output": {
              "type": "string",
              "description": "output of the action. the string can contain anything right from XML, \nJSON to simple path string, if there is no output it'll be empty"
            },
            "actionStatus": {
              "type": "integer",
              "description": "enum for status of the action",
              "enum": [
                -1,
                0,
                1,
                2,
                3,
                4,
                5
              ],
              "tsEnumNames": [
                "Undefined",
                "Ready",
                "Executing",
                "Completed",
                "CouldNotRun",
                "FailedRetryPending",
                "Failed"
              ]

            "percentComplete": {
              "type": "number",
              "description": "Percentage to which the download is completed"
            },
            "timeRemaining": {
              "type": "number",
              "description": "time remaining for download complete"
            },
            "downloadSpeed": {
              "type": "number",
              "description": "speed of the download"
            },
            "totalBytes": {
              "type": "number",
              "description": "total size of the download, in bytes"
            },
            "bytesDone": {
              "type": "number",
              "description": "bytes that are downloaded so far"
            },
            "taskId": {
              "type": "string",
              "description": "Id of the download task"
            },
            "downloadedLocation": {
              "type": "string",
              "description": "path of the downloaded file"
            },
            "failureCount": {
              "type": "integer",
              "description": "number of times the download failed"
            },
            "version": {
              "type": "string",
              "description": "version of the component being downloaded"
            },
            "downloadTypeInfo": {
              "$ref": "#/definitions/DownloadTypeInfo"
            },
            "httpResponseCode": {
              "type": "integer",
              "description": "http response code"
            },
            "errorCode": {
              "type": "string",
              "description": "error code from downloader"
            },
            "downloadPausedOnce": {
              "type": "integer",
              "description": "whether the download was paused once or not"
            },
            "downloadUrl": {
              "type": "string",
              "description": "url of the download"
            }
          },
          "required": [
            "downloadStatus",
            "percentComplete",
            "timeRemaining",
            "downloadSpeed",
            "totalBytes",
            "bytesDone",
            "taskId",
            "downloadedLocation",
            "failureCount",
            "version",
            "downloadTypeInfo",
            "httpResponseCode",
            "errorCode",
            "downloadPausedOnce",
            "downloadUrl"

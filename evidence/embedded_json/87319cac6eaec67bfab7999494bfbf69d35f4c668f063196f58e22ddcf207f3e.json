        "AddAppInfoToPersistence": {
          "description": "Adds App Information to persistence, if persistence file not present it will be created If App Information exists already, it will be Updated.",
          "isCommand": true,
          "persistent": false,
          "type": "object",
          "parameters": {
            "type": "object",
            "properties": {
              "appInfo": {
                "$ref": "#/definitions/AppInfo"
              }
            },
            "required": [
              "appInfo"
            ]
          }
        },
        "DeleteAppInfoFromPersistence": {
          "description": "Deletes App Information from persistence if persistence exists and it contains the app entry.",
          "isCommand": true,
          "persistent": false,
          "type": "object",
          "parameters": {
            "type": "object",
            "properties": {
              "appName": {
                "description": "Name of the app for which entry needs to be deleted",
                "type": "string"
              }
            },
            "required": [
              "appName"
            ]
          }
        },
        "GetAllAppInfoFromPersistence": {
          "description": "Fetches information for all apps from persistence.",
          "isCommand": true,
          "persistent": false,
          "type": "object",
          "return": {
            "type": "object",
            "properties": {
              "AppsInfo": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/AppInfo"
                },
                "description": "Array of all nodes, if no persistence then nothing will be returned"
              }
            }
          }
        }
      }

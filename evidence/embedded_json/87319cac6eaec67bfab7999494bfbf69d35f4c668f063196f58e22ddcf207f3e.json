      "id": "#loginId",
      "title": "loginId Endpoints",
      "type": "object",
      "module": "LoginId",
      "definitions": {
        "AppInfo": {
          "type": "object",
          "properties": {
            "applicationName": {
              "type": "string"
            },
            "idpId": {
              "type": "string"
            },

        {
          "name": "nvapp_client_get_laptop_features",
          "description": "Get Battery Boost and Whisper Mode settings globally or for a game. This setting is applicable only for notebooks.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "game": {
                "type": "string",
                "minLength": 1,
                "description": "Game name from nvapp_client_get_applications. Use 'global' or 'base' for global settings; defaults to global."
              }
            },
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "enum": [
                  "global",
                  "application"
                ]
              },
              "game": {
                "type": "string",
                "description": "Game name when scope is application."
              },
              "batteryBoost": {
                "type": "object",
                "properties": {
                  "supported": {
                    "type": "boolean"
                  },
                  "useGlobal": {
                    "type": "boolean",
                    "description": "Whether the application inherits the global setting. Returned only for application scope."
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "Effective enabled state."
                  },
                  "frameRate": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Effective Battery Boost frame rate."
                  }
                },
                "required": [
                  "supported"
                ],
                "if": {
                  "properties": {
                    "supported": {
                      "const": true
                    }
                  },
                  "required": [
                    "supported"
                  ]
                },
                "then": {
                  "required": [
                    "enabled"
                  ]
                },
                "additionalProperties": false
              },
              "whisperMode": {
                "type": "object",
                "properties": {
                  "supported": {
                    "type": "boolean"
                  },
                  "useGlobal": {
                    "type": "boolean",
                    "description": "Whether the application inherits the global setting. Returned only for application scope."
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "Effective enabled state."
                  },
                  "fanVolume": {
                    "type": "string",
                    "enum": [
                      "Balanced",
                      "Quiet",
                      "Quieter"
                    ],
                    "description": "Effective acoustic level."
                  },
                  "frameRate": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Effective Whisper Mode frame rate."
                  }
                },
                "required": [
                  "supported"
                ],
                "if": {
                  "properties": {
                    "supported": {
                      "const": true
                    }
                  },
                  "required": [
                    "supported"
                  ]
                },
                "then": {
                  "required": [
                    "enabled"
                  ]
                },
                "additionalProperties": false
              }
            },
            "required": [
              "scope",
              "batteryBoost",
              "whisperMode"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "scope": {
                      "const": "application"
                    }
                  },
                  "required": [
                    "scope"
                  ]
                },
                "then": {
                  "required": [
                    "game"
                  ],
                  "properties": {
                    "batteryBoost": {
                      "required": [
                        "useGlobal"
                      ]
                    },
                    "whisperMode": {
                      "required": [
                        "useGlobal"
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "batteryBoost": {
                      "not": {
                        "required": [
                          "useGlobal"
                        ]
                      }
                    },
                    "whisperMode": {
                      "not": {
                        "required": [
                          "useGlobal"
                        ]
                      }
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": true,
            "destructiveHint": false,
            "idempotentHint": true,
            "openWorldHint": false
          },
          "_meta_internal": {
            "priority": "P0",
            "needsConsent": false,
            "responseExample": {
              "scope": "application",
              "game": "Cyberpunk 2077",
              "batteryBoost": {
                "supported": true,
                "useGlobal": true,
                "enabled": true,
                "frameRate": 60
              },
              "whisperMode": {
                "supported": true,
                "useGlobal": false,
                "enabled": false,
                "fanVolume": "Quiet",
                "frameRate": 40
              }
            }
          }
        },

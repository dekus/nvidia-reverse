                                "UNKNOWN"
                              ],
                              "description": "Configured optimization state for this power profile."
                            },
                            "availablePresets": {
                              "type": "array",
                              "description": "Presets supported by this power profile.",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "Balanced",
                                  "Performance",
                                  "Recommended",
                                  "Quality"
                                ]
                              },
                              "uniqueItems": true
                            },
                            "unavailableReason": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Why presets cannot be applied and how to proceed."
                            }
                          },
                          "required": [
                            "currentState",
                            "availablePresets"
                          ]
                        }
                      },
                      "required": [
                        "ac",
                        "battery"
                      ]
                    }
                  },
                  "required": [

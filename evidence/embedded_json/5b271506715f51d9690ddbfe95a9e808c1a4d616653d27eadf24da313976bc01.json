        {
          "name": "nvapp_client_set_game_optimization",
          "description": "Apply a game optimization preset or restore defaults for a supported game. The AC power profile is used when powerSource is omitted.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "game": {
                "type": "string",
                "minLength": 1,
                "description": "Exact game or application name returned by nvapp_client_get_applications."

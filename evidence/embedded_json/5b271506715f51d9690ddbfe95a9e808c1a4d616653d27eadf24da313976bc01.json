      "tools": [
        {
          "name": "nvapp_echo",
          "description": "Echoes the input message back. Use for testing NvApp SDK connectivity.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "description": "The message to echo back"
              },
              "require_confirmation": {
                "type": "boolean",
                "description": "Testing aid for MCP 2026-07-28 multi round-trip requests. When true, the server returns an input_required result and the call only completes after the client confirms. Ignored by clients using MCP 2025-11-25 or earlier."
              },
              "simulate_progress": {
                "type": "boolean",
                "description": "Testing aid for MCP progress notifications. When true and the request carries a progressToken, the echo runs as a short multi-step async operation emitting notifications/progress before completing. Ignored if no progressToken is provided."
              }
            },
            "required": [
              "message"
            ]
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "echo": {
                "type": "string",
                "description": "The echoed message"
              },
              "timestamp_ms": {
                "type": "integer",
                "description": "Server timestamp in milliseconds"
              }
            },
            "required": [
              "echo",
              "timestamp_ms"
            ]
          },
          "annotations": {
            "readOnlyHint": true,
            "destructiveHint": false,
            "idempotentHint": true,
            "openWorldHint": false
          },
          "_meta_internal": {
            "priority": "P2",

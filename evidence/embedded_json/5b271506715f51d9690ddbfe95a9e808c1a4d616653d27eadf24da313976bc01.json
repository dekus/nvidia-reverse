        {
          "name": "nvapp_client_get_applications",
          "description": "List NVIDIA app-discovered games and applications with OPS details. Optional inputs filter results; omit all to return every app. Returned game names identify apps in game-scoped tools.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "game": {
                "type": "string",
                "minLength": 1,
                "description": "Optional exact game or application name previously returned by this tool. Omit to enumerate all discovered applications."
              },
              "preset": {
                "type": "string",

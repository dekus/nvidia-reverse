              "preset": {
                "type": "string",
                "enum": [
                  "Balanced",
                  "Performance",
                  "Recommended",
                  "Quality",
                  "Revert"
                ],
                "description": "Preset to apply: Performance (frame rate), Balanced (slider midpoint), Recommended (NVIDIA per-game recommendation), Quality (image quality), or Revert (restore defaults for the selected power profile)."
